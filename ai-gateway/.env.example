# ==============================================================================
# AI Gateway Environment Variables Template (SAFE FOR VERSION CONTROL)
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="Enterprise AI Gateway"

# Master Administration Secret (Used for Admin Bypass & Management)
GATEWAY_ADMIN_KEY=your_gateway_admin_secret_key_here
DEFAULT_MASTER_KEY=gw-live-master-enterprise-key-2026

# ------------------------------------------------------------------------------
# LLM Provider API Keys (Fill in the providers you plan to use)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL + pgvector or local SQLite async fallback)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./gateway.db
POSTGRES_USER=gateway
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=aigateway
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis Settings (Exact Match Cache & Distributed Sliding Window Rate Limits)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# ClickHouse Settings (Telemetry & Analytical Logs)
# ------------------------------------------------------------------------------
CLICKHOUSE_URL=http://default:clickhouse_secret@localhost:8123/gateway_telemetry
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_password_here
CLICKHOUSE_DB=gateway_telemetry
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# ------------------------------------------------------------------------------
# Gateway Optimization & Safety Toggles
# ------------------------------------------------------------------------------
EXACT_CACHE_ENABLED=true
EXACT_CACHE_TTL=3600
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.88
RATE_LIMIT_ENABLED=true
GUARDRAILS_ENABLED=true
DEFAULT_ROUTING_STRATEGY=cost-optimized
HTTP_TIMEOUT_SECONDS=45.0

# ------------------------------------------------------------------------------
# Frontend Dashboard Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
